{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@creative-agent/schemas": ["./packages/schemas/src"],
      "@creative-agent/schemas/*": ["./packages/schemas/src/*"]
    }
  },
  "include": [
    "packages/**/*",
    "apps/**/*",
    "tests/**/*"
  ],
  "exclude": [
    "node_modules",
    "storage",
    "projects"
  ]
}
